# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client, never prefix with NEXT_PUBLIC_.
# Used exclusively by lib/supabase/admin.ts for cron and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by `pnpm db:migrate` / `db:seed` to run DDL.
# Dashboard → Project Settings → Database → Connection string → URI.
# A different credential from the service-role key, which speaks PostgREST and
# cannot run DDL. Only needed for migrations — the app itself never uses it.
SUPABASE_DB_URL=

# ── AI ──────────────────────────────────────────────────────────────────────
# OPTIONAL. Server-only. Grades written answers against stored rubrics, drives
# the AI Interviewer, and parses job descriptions.
#
# EngForge runs without any AI key: answers are still saved and still produce
# evidence, XP, and weaknesses. Multiple-choice grading, coding tests, and every
# mastery calculation are unaffected. Written answers fall back to a keyword
# score capped at 60%, which deliberately cannot resolve a weakness or promote a
# skill on evidence that was never verified.
#
# Gemini is the default because its flash models are free — get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-2.5-flash (default), gemini-3.5-flash, and gemini-3.6-flash are all
# free. Leave AI_MODEL unset to take the provider default.
AI_MODEL=

# Optional: "gemini" (default) or "anthropic". Inferred from whichever key is
# set when unspecified.
AI_PROVIDER=

# Only needed if AI_PROVIDER=anthropic. Paid — no free tier.
ANTHROPIC_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret guarding /api/cron/* (nightly snapshots, view refresh).
CRON_SECRET=
