# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client, never prefix with NEXT_PUBLIC_.
# Used exclusively by lib/supabase/admin.ts for cron and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ──────────────────────────────────────────────────────────────────────
# Server-only. Grades explanations, drives the AI Interviewer, parses JDs.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret guarding /api/cron/* (nightly snapshots, view refresh).
CRON_SECRET=
