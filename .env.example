# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client, never prefix with NEXT_PUBLIC_.
# Used exclusively by lib/supabase/admin.ts for cron and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by `pnpm db:migrate` / `db:seed` to run DDL.
# Dashboard → Project Settings → Database → Connection string → URI.
# A different credential from the service-role key, which speaks PostgREST and
# cannot run DDL. Only needed for migrations — the app itself never uses it.
SUPABASE_DB_URL=

# ── AI ──────────────────────────────────────────────────────────────────────
# OPTIONAL. Server-only. Grades explanations, drives the AI Interviewer,
# parses job descriptions.
#
# EngForge runs without it: answers are still saved and still produce evidence,
# XP, and weaknesses. Multiple-choice grading is unaffected. Written answers
# fall back to a keyword score capped at 60%, which deliberately cannot resolve
# a weakness or promote a skill on evidence that was never verified.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret guarding /api/cron/* (nightly snapshots, view refresh).
CRON_SECRET=
